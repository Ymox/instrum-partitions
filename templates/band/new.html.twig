{% extends app.request.isXmlHttpRequest() ? 'base_modal.html.twig': 'base.html.twig' %}

{% block title %}{{ 'app.band.new.title'|trans }}{% if not app.request.xmlHttpRequest %} | {{ parent() }}{% endif %}{% endblock %}

{% block body %}
	{% if not app.request.xmlHttpRequest %}
	<h1>{{ 'app.band.new.heading'|trans }}</h1>
	{% endif %}

	{{ form_start(form, {'attr': {'class': app.request.xmlHttpRequest ? 'ajaxify' : null}}) }}
		{{ form_widget(form) }}
		<button type="submit" class="btn btn-primary float-start" title="{{ 'global.action.validate'|trans }}" aria-label="{{ 'global.action.validate'|trans }}">✔️</button>
	{{ form_end(form) }}
	{% if not app.request.isXmlHttpRequest() %}
	<a href="{{ path('band_index') }}" class="btn btn-outline-secondary float-end" title="{{ 'global.action.list'|trans }}" aria-label="{{ 'global.action.list'|trans }}">📃</a>
	{% endif %}
{% endblock %}
