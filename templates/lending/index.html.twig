{% extends 'base.html.twig' %}

{% block title %}{{ 'app.lending.index.title'|trans }} | {{ parent() }}{% endblock %}

{% block body %}
	<h1>{{ 'app.lending.index.heading'|trans }}</h1>

	<table class="table table-sm table-hover">
		<colgroup>
			<col />
			<col />
			<col />
			<col class="col-2 col-sm-3 col-md-2 col-xl-1" />
		</colgroup>
		<thead>
			<tr>
				<th colspan="4">
					{% set page = app.request.query.get('page', 1) %}
					{% include 'pagination.html.twig' with {'page': page, 'nbPages': nbPages, 'objectName': 'lending'} %}
				</th>
			</tr>
			<tr>
				<th>{{ 'app.fields.lending.band'|trans }}
					({{ 'app.fields.lending.contact'|trans }})</th>
				<th>{{ 'app.fields.lending.start'|trans }}</th>
				<th>{{ 'app.fields.lending.end'|trans }}</th>
				<th class="text-center"><a href="{{ path('lending_new') }}" class="btn btn-sm btn-success" title="{{ 'global.action.new'|trans }}" aria-label="{{ 'global.action.new'|trans }}">➕</a></th>
			</tr>
		</thead>
		<tfoot class="table-group-divider">
			<tr>
				<th colspan="4">
					{% include 'pagination.html.twig' with {'page': page, 'nbPages': nbPages, 'objectName': 'lending'} %}
				</th>
			</tr>
		</tfoot>
		<tbody class="table-group-divider">
		{% for lending in lendings %}
			<tr>
				<td><a href="{{ path('lending_show', {'id': lending.id}) }}">{{ ('app.lending.ours.' ~ (lending.ours ? 'to' : 'by'))|trans ~ ' ' ~ lending.band }}</a>
					({{ lending.contact }})</td>
				<td>{{ lending.start|date('Y-m-d') }}</td>
				<td>{% if lending.end %}{{ lending.end|date('Y-m-d') }}{% else %}{{ 'app.lending.index.not_ended'|trans }}{% endif %}</a></td>
				<td class="text-center"><a href="{{ path('lending_show', {'id': lending.id}) }}" class="btn btn-sm btn-outline-info" title="{{ 'global.action.show'|trans }}" aria-label="{{ 'global.action.show'|trans }}">👁️</a>
					<a href="{{ path('band_show', {'id': lending.band.id}) }}" class="btn btn-sm btn-outline-secondary">👥</a>
					<a href="{{ path('lending_edit', {'id': lending.id}) }}" class="btn btn-sm btn-outline-warning" title="{{ 'global.action.edit'|trans }}" aria-label="{{ 'global.action.edit'|trans }}">✏️</a></td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
{% endblock %}