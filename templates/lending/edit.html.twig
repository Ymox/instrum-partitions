{% extends 'base.html.twig' %}

{% block title %}{{ ('app.lending.edit.title.' ~ (lending.ours ? 'to' : 'by'))|trans({'band': lending.band, 'date': lending.start|date('Y-m-d')}) }} | {{ parent() }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ assets_host }}/select2/4.0.13/css/select2.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<link rel="stylesheet" href="{{ assets_host }}/select2-bootstrap-5-theme/1.3.0/select2-bootstrap-5-theme.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
{% endblock %}

{% block body %}
	<h1>{{ ('app.lending.edit.title.' ~ (lending.ours ? 'to' : 'by'))|trans({'band': lending.band, 'date': lending.start|date('Y-m-d')}) }}</h1>

	{{ form_start(edit_form) }}
		{{ form_widget(edit_form) }}
		<button type="submit" class="btn btn-primary float-start" title="{{ 'global.action.validate'|trans }}" aria-label="{{ 'global.action.validate'|trans }}">✔️</button>
	{{ form_end(edit_form) }}

	<ul class="list-inline float-end">
		<li class="list-inline-item">
			<a href="{{ path('lending_index') }}" class="btn btn-outline-secondary" title="{{ 'global.action.list'|trans }}" aria-label="{{ 'global.action.list'|trans }}">📃</a>
		</li>
		<li class="list-inline-item">
			<a href="{{ path('lending_edit', {'id': lending.id}) }}" class="btn btn-warning" title="{{ 'global.action.edit'|trans }}" aria-label="{{ 'global.action.edit'|trans }}">✏️</a>
		</li>
		<li class="list-inline-item">
			{{ form_start(delete_form) }}
				<button type="submit" class="btn btn-danger" title="{{ 'global.action.delete'|trans }}" aria-label="{{ 'global.action.delete'|trans }}">🗑️</button>
			{{ form_end(delete_form) }}
		</li>
	</ul>
{% endblock %}

{% block javascripts %}
		<script src="{{ assets_host }}/select2/4.0.13/js/select2.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
		<script src="{{ asset('js/entity_adder.js') }}" data-entity-adder-prototype="{{ block('entity_adder', 'forms.html.twig')|e('html_attr') }}"></script>
		<script src="{{ asset('js/collection_adder.js') }}" data-collection-adder-prototype="{{ block('collection_adder', '_form.html.twig')|e('html_attr') }}" data-collection-remover-prototype="{{ block('collection_remover', '_form.html.twig')|e('html_attr') }}"></script>
		<script src="{{ asset('js/ajaxify.js') }}"></script>
		<script>/*<[CDATA[*/
		$(function() {
			$('select.searchable').select2({
				theme: "bootstrap-5"
			});
		});
		/*]]>*/
		</script>
{% endblock %}