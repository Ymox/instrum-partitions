{% extends 'base.html.twig' %}

{% block title %}{{ 'app.size.index.title'|trans }} | {{ parent() }}{% endblock %}

{% block body %}
	<h1>{{ 'app.size.index.heading'|trans }}</h1>

	<table class="table table-sm table-hover">
		<thead>
			<tr>
				<th>{{ 'app.fields.size.name'|trans }}</th>
				<th>{{ 'app.fields.size.note'|trans }}</th>
				<th class="text-center"><a href="{{ path('size_new') }}" class="btn btn-sm btn-success" title="{{ 'global.action.new'|trans }}" aria-label="{{ 'global.action.new'|trans }}">➕</a></th>
			</tr>
		</thead>
		<tbody class="table-group-divider">
		{% for size in sizes %}
			<tr>
				<td><a href="{{ path('size_show', {'name': size.name}) }}">{{ size.name }}</a></td>
				<td>{{ size.note }}</td>
				<td>
					<a href="{{ path('size_show', {'name': size.name}) }}" class="btn btn-sm btn-outline-info" title="{{ 'global.action.show'|trans }}" aria-label="{{ 'global.action.show'|trans }}">👁️</a>
					<a href="{{ path('size_edit', {'name': size.name}) }}" class="btn btn-sm btn-outline-warning" title="{{ 'global.action.edit'|trans }}" aria-label="{{ 'global.action.edit'|trans }}">✏️</a>
				</td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
{% endblock %}