{% extends 'base.html.twig' %}

{% block title %}
	{%- if not instrument.key -%}
		{{ instrument.name }}
	{%- else -%}
		{{ 'app.instrument.full_name'|trans({'name': instrument.name, 'key': ('app.fields.instrument.key.choices.' ~ instrument.key)|trans}) }}
	{%- endif %} | {{ parent() }}{% endblock %}

{% block body %}
	<h1>{% if not instrument.key -%}
			{{ instrument.name }}
		{%- else -%}
			{{ 'app.instrument.full_name'|trans({'name': instrument.name, 'key': ('app.fields.instrument.key.choices.' ~ instrument.key)|trans}) }}
		{%- endif %}</h1>

	{{ include('instrument/_form.html.twig', {'form': edit_form}) }}

	<ul class="list-inline float-end">
		<li class="list-inline-item">
			<a href="{{ path('instrument_index') }}" class="btn btn-light"><i class="fas fa-list" title="{{ 'global.action.list'|trans }}" aria-hidden="true"></i><span class="visually-hidden">{{ 'global.action.list'|trans }}</span></a>
		</li>
		<li class="list-inline-item">
			{{ form_start(delete_form) }}
				<button type="submit" class="btn btn-danger"><i class="fas fa-trash" title="{{ 'global.action.delete'|trans }}" aria-hidden="true"></i><span class="visually-hidden">{{ 'global.action.delete'|trans }}</span></button>
			{{ form_end(delete_form) }}
		</li>
	</ul>
{% endblock %}
