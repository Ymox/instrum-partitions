{% extends 'base.html.twig' %}

{% block title %}{{ 'app.instrument.index.title'|trans }} | {{ parent() }}{% endblock %}

{% block body %}
	<h1>{{ 'app.instrument.index.heading'|trans }}</h1>

	<table class="table table-sm table-hover">
		<colgroup>
			<col />
			<col />
			<col class="col-1" />
		</colgroup>
		<thead>
			<tr>
				<th colspan="3">
					{% set page = app.request.query.get('page', 1) %}
					{% include 'pagination.html.twig' with {'page': page, 'nbPages': nbPages, 'objectName': 'instrument'} %}
				</th>
			</tr>
			<tr>
				<th>{{ 'app.fields.instrument.name'|trans }}</th>
				<th>{{ 'app.fields.instrument.family.label'|trans }}</th>
				<th class="text-center"><a href="{{ path('instrument_new') }}" class="btn btn-sm btn-success" title="{{ 'global.action.new'|trans }}" aria-label="{{ 'global.action.new'|trans }}">➕</a></th>
			</tr>
		</thead>
		<tfoot class="table-group-divider">
			<tr>
				<th colspan="3">
					{% include 'pagination.html.twig' with {'page': page, 'nbPages': nbPages, 'objectName': 'instrument'} %}
				</th>
			</tr>
		</tfoot>
		<tbody class="table-group-divider">
		{% for instrument in instruments %}
			<tr>
				<td>
				{%- if instrument.common %}⭐ {% endif -%}
				{%- if not instrument.key -%}
					{{ instrument.name }}
				{%- else -%}
					{{ 'app.instrument.full_name'|trans({'name': instrument.name, 'key': instrument.key|trans}) }}
				{%- endif %}</td>
				<td>{{ instrument.family ? instrument.family|trans }}</td>
				<td class="text-center"><a href="{{ path('instrument_edit', {'id': instrument.id}) }}" class="btn btn-sm btn-outline-warning" title="{{ 'global.action.edit'|trans }}" aria-label="{{ 'global.action.edit'|trans }}">✏️</a></td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
{% endblock %}
