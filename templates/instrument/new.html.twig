{% extends app.request.xmlHttpRequest ? 'base_modal.html.twig' : 'base.html.twig' %}

{% block title %}{{ 'app.instrument.new.title'|trans }}{% if not app.request.xmlHttpRequest %} | {{ parent() }}{% endif %}{% endblock %}

{% block body %}
	{% if not app.request.xmlHttpRequest %}
	<h1>{{ 'app.instrument.new.heading'|trans }}</h1>
	{% endif %}

	{{ include('piece/_form.html.twig', {'form': edit_form}) }}

	{% if not app.request.isXmlHttpRequest() %}
	<a href="{{ path('instrument_index') }}" class="btn btn-outline-secondary float-end" title="{{ 'global.action.list'|trans }}" aria-label="{{ 'global.action.list'|trans }}">📃</a>
	{% endif %}
{% endblock %}
