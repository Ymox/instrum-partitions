	{{ form_start(form) }}
		<div class="row">
			{{ form_row(form.name, {'row_attr': {'class': 'mb-3 col-md-6'}}) }}
			{{ form_row(form.key, {'row_attr': {'class': 'mb-3 col-4 col-md-2'}}) }}
			<div class="mb-3 col-4 col-md-2">
				<label class="form-label mb-3"> </label>
				{{ form_widget(form.common) }}
			</div>
			{{ form_row(form.family, {'row_attr': {'class': 'mb-3 col-4 col-md-2'}}) }}
		</div>
		<button type="submit" class="btn btn-primary float-start" title="{{ 'global.action.validate'|trans }}" aria-label="{{ 'global.action.validate'|trans }}">✔️</button>
	{{ form_end(form) }}