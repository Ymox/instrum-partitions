{% extends 'base.html.twig' %}

{% block title %}{{ piece.name }} | {{ parent() }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('style/dropzone.css') }}" />
<link rel="stylesheet" href="{{ assets_host }}/select2/4.0.13/css/select2.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<link rel="stylesheet" href="{{ assets_host }}/select2-bootstrap-5-theme/1.3.0/select2-bootstrap-5-theme.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
{% endblock %}

{% block body %}
	<h1>{{ piece.name }}
		{%- if piece.translation %}<br />
		<small>{{ piece.translation }}</small>{% endif %}</h1>

	{{ include('piece/_form.html.twig', {'form': edit_form}) }}

	<ul class="list-inline float-end">
		<li class="list-inline-item">
			<a href="{{ path('piece_index') }}" class="btn btn-outline-secondary" title="{{ 'global.action.list'|trans }}" aria-label="{{ 'global.action.list'|trans }}">📃</a>
		</li>
		<li class="list-inline-item">
			{{ form_start(delete_form) }}
				<button type="submit" class="btn btn-danger" title="{{ 'global.action.delete'|trans }}" aria-label="{{ 'global.action.delete'|trans }}">🗑️</button>
			{{ form_end(delete_form) }}
		</li>
	</ul>
{% endblock %}

{% block javascripts %}
		<script src="{{ assets_host }}/select2/4.0.13/js/select2.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
		<script src="{{ asset('js/entity_adder.js') }}" data-entity-adder-prototype="{{ block('entity_adder', 'forms.html.twig')|e('html_attr') }}"></script>
		<script src="{{ asset('js/collection_adder.js') }}" data-collection-adder-prototype="{{ block('collection_adder', 'forms.html.twig')|e('html_attr') }}" data-collection-remover-prototype="{{ block('collection_remover', 'forms.html.twig')|e('html_attr') }}"></script>
		<script src="{{ asset('js/dragndrop.js') }}"></script>
		<script src="{{ asset('js/ajaxify.js') }}"></script>
		<script>/*<[CDATA[*/
		$(function() {
			$('select.searchable').select2({
				theme: "bootstrap-5"
			});
		});
		/*]]>*/
		</script>
{% endblock %}