{% extends 'base.html.twig' %}

{% block title %}{{ instrumentation.name }} | {{ parent() }}{% endblock %}

{% block body %}
	<h1>{{ instrumentation.name }}</h1>

	{{ form_start(edit_form) }}
		{{ form_widget(edit_form) }}
		<button type="submit" class="btn btn-primary float-start" title="{{ 'global.action.validate'|trans }}" aria-label="{{ 'global.action.validate'|trans }}">✔️</button>
	{{ form_end(edit_form) }}

	<ul class="list-inline float-end">
		<li class="list-inline-item">
			<a href="{{ path('instrumentation_index') }}" class="btn btn-outline-secondary" title="{{ 'global.action.list'|trans }}" aria-label="{{ 'global.action.list'|trans }}">📃</a>
		</li>
		<li class="list-inline-item">
			{{ form_start(delete_form) }}
				<button type="submit" class="btn btn-danger" title="{{ 'global.action.delete'|trans }}" aria-label="{{ 'global.action.delete'|trans }}">🗑️</button>
			{{ form_end(delete_form) }}
		</li>
	</ul>
{% endblock %}