{% extends 'base.html.twig' %}

{% block title %}{{ 'app.instrumentation.new.title'|trans }} | {{ parent() }}{% endblock %}

{% block body %}
	<h1>{{ 'app.instrumentation.new.heading'|trans }}</h1>

	{{ form_start(form) }}
		{{ form_widget(form) }}
		<button type="submit" class="btn btn-primary float-start" title="{{ 'global.action.validate'|trans }}" aria-label="{{ 'global.action.validate'|trans }}">✔️</button>
	{{ form_end(form) }}

	<a href="{{ path('instrumentation_index') }}" class="btn btn-outline-secondary float-end" title="{{ 'global.action.list'|trans }}" aria-label="{{ 'global.action.list'|trans }}">📃</a>
{% endblock %}