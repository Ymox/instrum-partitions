{% extends 'base.html.twig' %}

{% block body %}
	<h1>{{ program.name }}</h1>

	<table class="table table-sm">
		<tbody class="table-group-divider">
			<tr>
				<th>{{ 'app.fields.program.updated_at'|trans }}</th>
				<td>{{ program.updatedAt|date('Y-m-d à H:i') }}</td>
			</tr>
			<tr>
				<th colspan="2">{{ 'app.fields.program.pieces'|trans }}</th>
			</tr>
			{% for piece in program.pieces -%}
			<tr>
				<td colspan="2"><a href="{{ path('piece_show', {'id': piece.id}) }}">{{ piece.name }}</a></td>
			</tr>
			{% endfor -%}
		</tbody>
	</table>

	<ul class="list-inline float-end">
		<li class="list-inline-item">
			<a href="{{ path('program_index') }}" class="btn btn-outline-secondary" title="{{ 'global.action.list'|trans }}" aria-label="{{ 'global.action.list'|trans }}">📃</a>
		</li>
		<li class="list-inline-item">
			<a href="{{ path('program_edit', {'id': program.id}) }}" title="{{ 'global.action.edit'|trans }}" class="btn btn-warning" title="{{ 'global.action.edit'|trans }}" aria-label="{{ 'global.action.edit'|trans }}">✏️</a>
		</li>
		<li class="list-inline-item">
			{{ form_start(delete_form) }}
				<button type="submit" class="btn btn-danger" title="{{ 'global.action.delete'|trans }}" aria-label="{{ 'global.action.delete'|trans }}">🗑️</button>
			{{ form_end(delete_form) }}
		</li>
	</ul>
{% endblock %}
