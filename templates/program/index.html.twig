{% extends 'base.html.twig' %}

{% block title %}{{ 'app.program.index.title'|trans }} | {{ parent() }}{% endblock %}

{% block body %}
	<h1>{{ 'app.program.index.heading'|trans }}</h1>

	<table class="table table-sm table-hover">
		<colgroup>
			<col />
			<col />
			<col class="col-2 col-sm-3 col-md-2 col-xl-1" />
		</colgroup>
		<thead>
			<tr>
				<th colspan="3">
					{% set page = app.request.query.get('page', 1) %}
					{% include 'pagination.html.twig' with {'page': page, 'nbPages': nbPages, 'objectName': 'program'} %}
				</th>
			</tr>
			<tr>
				<th>{{ 'app.fields.program.name'|trans }}</th>
				<th>{{ 'app.fields.program.updated_at'|trans }}</th>
				<th class="text-center"><a href="{{ path('program_new') }}" class="btn btn-sm btn-success" title="{{ 'global.action.new'|trans }}" aria-label="{{ 'global.action.new'|trans }}">➕</a></th>
			</tr>
		</thead>
		<tfoot class="table-group-divider">
			<tr>
				<th colspan="3">
					{% include 'pagination.html.twig' with {'page': page, 'nbPages': nbPages, 'objectName': 'program'} %}
				</th>
			</tr>
		</tfoot>
		<tbody class="table-group-divider">
		{% for program in programs %}
			<tr>
				<td><a href="{{ path('program_show', {'id': program.id}) }}">{{ program.name }}</a></td>
				<td>{{ program.updatedAt|date('Y-m-d H:i') }}</td>
				<td class="text-center"><a href="{{ path('program_show', {'id': program.id}) }}" class="btn btn-sm btn-outline-info" title="{{ 'global.action.show'|trans }}" aria-label="{{ 'global.action.show'|trans }}">👁️</a>
					<a href="{{ path('program_edit', {'id': program.id}) }}" class="btn btn-sm btn-outline-warning" title="{{ 'global.action.edit'|trans }}" aria-label="{{ 'global.action.edit'|trans }}">✏️</a></td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
{% endblock %}